# Copy to .env (never commit .env). Used by docker compose.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
# Four-eyes: every decision needs a different approver. Leave true in production.
MATCHBOOK_REQUIRE_CHECKER=true
# Set true when served over HTTPS so the session cookie is Secure.
MATCHBOOK_COOKIE_SECURE=false
# Comma-separated Host names the app will answer to.
MATCHBOOK_ALLOWED_HOSTS=localhost,127.0.0.1
MATCHBOOK_SESSION_HOURS=8
MATCHBOOK_IDLE_MINUTES=60
# Demo data replaces loaded data: keep off outside a sandbox.
MATCHBOOK_ENABLE_DEMO=false
